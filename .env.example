# Nordvra – miljövariabler / environment variables
# Kopiera till .env.local och fyll i riktiga värden. Checka ALDRIG in riktiga nycklar.
# Copy to .env.local and fill in real values. NEVER commit real keys.
# Variabler som börjar med NEXT_PUBLIC_ hamnar i webbläsaren – lägg aldrig hemligheter där.
# NEXT_PUBLIC_* values are sent to the browser – never put secrets in them.

# --- Supabase -------------------------------------------------------------------------------
# Projektets URL och publiceringsnyckel (publishable key, "sb_publishable_…").
# Project URL and publishable key. No service-role key is used anywhere in the app.
# Saknas de används seed-katalogen och admin är avstängd. / Without them the seed catalogue is
# used and the admin is disabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Kryptering av personnummer / personnummer encryption (server only) ----------------------
# 32 slumpmässiga byte som base64 (AES-256-GCM). Skapa med: openssl rand -base64 32
# 32 random bytes as base64. Byt inte nyckel utan migrering – gamla värden går då inte att läsa.
# Do not rotate without a migration, or stored values can no longer be decrypted.
PII_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# --- Webbplatsens adress / public site URL ---------------------------------------------------
# Används i länkar i mejl och SMS (t.ex. offertlänken). Utan avslutande snedstreck.
# Used for links in emails/SMS (e.g. the quote link). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-post / email ---------------------------------------------------------------------------
# console = skickar inget, loggar bara mottagarens domän och ämnesrad (standard).
# resend  = skickar via Resend. OTESTAT – aktivera medvetet efter domänverifiering (SPF/DKIM).
# console = sends nothing, logs only the recipient's domain and the subject (default).
# resend  = sends via Resend. UNTESTED – enable deliberately after verifying the domain.
EMAIL_PROVIDER=console
# Krävs bara när EMAIL_PROVIDER=resend. / Only needed when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Avsändare, t.ex. / sender, e.g. "Nordvra <info@nordvra.se>"
EMAIL_FROM=

# --- SMS --------------------------------------------------------------------------------------
# console = skickar inget, loggar bara de två sista siffrorna (standard).
# 46elks  = ännu inte implementerat – SMS skickas inte. / not implemented yet – nothing is sent.
SMS_PROVIDER=console
# 46elks API-användare och lösenord. / 46elks API username and password.
SMS_API_USER=
SMS_API_PASSWORD=
